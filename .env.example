# Server-only secrets. Never prefix these with VITE_.
# Create a local .env file from this example.

# Resend API key from https://resend.com
RESEND_API_KEY=

# Inbox that should receive transportation enquiries
QUOTE_NOTIFICATION_EMAIL=

# Verified Resend sender, e.g. Website <quotes@yourdomain.com>
QUOTE_FROM_EMAIL=

# Optional: public site origin used in emails, e.g. https://www.yourdomain.com
PUBLIC_SITE_URL=

# Google Gemini API key for the website chat assistant (https://aistudio.google.com/apikey).
# Leave empty to use the scripted chatbot only.
GEMINI_API_KEY=

# Optional: Gemini model for the chat assistant (default gemini-flash-latest)
GEMINI_MODEL=
